* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', sans-serif;
}

body {
    background: url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
    background-size: cover;
    color: white;
    min-height: 100vh;
}

.background-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6); /* Затемнение фона */
    z-index: -1;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
}

header {
    text-align: center;
    margin-bottom: 40px;
}

header h1 span {
    display: block;
    font-size: 0.5em;
    color: #00ff88;
    letter-spacing: 5px;
}

nav {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    gap: 10px;
}

.nav-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 10px 25px;
    color: white;
    cursor: pointer;
    border-radius: 50px;
    transition: 0.3s;
    backdrop-filter: blur(5px);
}

.nav-btn:hover, .nav-btn.active {
    background: #00ff88;
    color: #111;
    font-weight: bold;
}

.glass-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

h2 { margin-bottom: 20px; color: #00ff88; }

table {
    width: 100%;
    border-collapse: collapse;
}

th { text-align: left; padding: 15px; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
td { padding: 15px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

.match-item {
    display: flex;
    justify-content: space-between;
    padding: 15px;
    background: rgba(255, 255, 255, 0.05);
    margin-bottom: 10px;
    border-radius: 10px;
    align-items: center;
}

.score {
    font-size: 1.2em;
    font-weight: bold;
    color: #00ff88;
    background: rgba(0,0,0,0.3);
    padding: 5px 15px;
    border-radius: 5px;
}

.tab-content { display: none; }
.tab-content.active { display: block; animation: fadeIn 0.5s; }

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
